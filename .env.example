# Cổng server sẽ lắng nghe
PORT=3000

# Timeout cho mỗi request HTTP ra ngoài (ms)
REQUEST_TIMEOUT_MS=12000

# Số redirect tối đa được theo dõi trước khi bỏ cuộc
MAX_REDIRECTS=8

# Giới hạn số byte đọc từ response body
MAX_RESPONSE_BYTES=524288

# User-Agent gửi kèm request (để trống dùng giá trị mặc định trong code)
# USER_AGENT=

# Danh sách origin được phép gọi API, ngăn cách bằng dấu phẩy.
# Dùng "*" để cho phép tất cả (chỉ nên dùng khi phát triển/demo).
ALLOWED_ORIGINS=*

# Rate limit cho endpoint /api/bypass
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Đặt "true" nếu deploy sau reverse proxy / load balancer (Render, Railway, Heroku, Nginx...)
TRUST_PROXY=true
